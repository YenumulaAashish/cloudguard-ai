  "pr": {
    "$defs": {
      "count": {
        "maximum": 1000000,
        "minimum": 0,
        "type": "integer"
      },
      "gate": {
        "enum": [
          "PASS",
          "FAIL",
          "UNKNOWN"
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "advisory": {
        "additionalProperties": false,
        "properties": {
          "findings_reviewed": {
            "$ref": "#/$defs/count"
          },
          "mode": {
            "enum": [
              "offline",
              "ai",
              "NOT_RUN"
            ]
          }
        },
        "required": [
          "mode",
          "findings_reviewed"
        ],
        "type": "object"
      },
      "findings": {
        "additionalProperties": false,
        "properties": {
          "approved_exceptions": {
            "$ref": "#/$defs/count"
          },
          "failed": {
            "$ref": "#/$defs/count"
          },
          "total": {
            "$ref": "#/$defs/count"
          }
        },
        "required": [
          "total",
          "failed",
          "approved_exceptions"
        ],
        "type": "object"
      },
      "generated_by": {
        "const": "cloudguard-ai"
      },
      "informational_only": {
        "const": true
      },
      "policy": {
        "additionalProperties": false,
        "properties": {
          "checkov": {
            "$ref": "#/$defs/gate"
          },
          "exception_contract": {
            "$ref": "#/$defs/gate"
          },
          "opa_conftest": {
            "$ref": "#/$defs/gate"
          },
          "policy_tests": {
            "$ref": "#/$defs/gate"
          }
        },
        "required": [
          "checkov",
          "opa_conftest",
          "exception_contract",
          "policy_tests"
        ],
        "type": "object"
      },
      "risk": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "enum": [
              "NONE",
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "requires_review": {
            "type": "boolean"
          },
          "score": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "score",
          "category",
          "requires_review"
        ],
        "type": "object"
      },
      "schema_version": {
        "const": "1.0"
      }
    },
    "required": [
      "schema_version",
      "generated_by",
      "informational_only",
      "policy",
      "findings",
      "risk",
      "advisory"
    ],
    "title": "CloudGuard-AI bounded sanitized PR summary",
    "type": "object"
  }
}
